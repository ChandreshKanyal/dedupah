# Copy to .env and edit. Never commit .env.
POSTGRES_USER=dedupe
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dedupe
DEDUPE_DATABASE_URL=sqlite:///data/judgments.db   # steward-decision store; use a postgresql:// URL in production

# ---- API security (see docs/SECURITY.md). Production needs ALL of the oidc settings, hosts, https and a server database. ----
DEDUPE_ENV=dev                    # dev | production
# development only (never production): shared-secret test tokens, create one with: python -m dedupe.api.devtoken --sub asha --roles steward
DEDUPE_DEV_AUTH_SECRET=           # at least 32 random characters
# username + password sign-in (small deployments, testing): DEDUPE_AUTH_MODE=local; create the first admin with `python -m dedupe.api.accounts_cli create-admin --username admin`
# DEDUPE_LOCAL_AUTH_SECRET=       # at least 32 random characters; signs the sign-in tokens
# DEDUPE_ALLOW_LOCAL_AUTH=yes     # production only: you accept local passwords instead of single sign-on
# production: tokens come from your identity provider
# DEDUPE_OIDC_ISSUER=https://idp.example.com/realms/bank
# DEDUPE_OIDC_AUDIENCE=dedupe-api
# DEDUPE_OIDC_JWKS_URL=https://idp.example.com/realms/bank/protocol/openid-connect/certs
# DEDUPE_OIDC_ROLES_CLAIM=roles   # dotted path allowed, e.g. realm_access.roles
# DEDUPE_OIDC_ROLE_MAP={"Dedupe-Stewards": "steward"}
# DEDUPE_ALLOWED_HOSTS=dedupe.bank.example
# DEDUPE_DATA_ROOTS=/data/sources # folders file sources may be read from (required in production)
# DEDUPE_TRUST_PROXY=true         # only behind your own proxy
